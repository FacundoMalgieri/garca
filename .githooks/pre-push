#!/usr/bin/env bash
# Última barrera: revisa TODO lo que se está por pushear —mensajes y diffs—,
# no sólo el último commit. Atrapa lo que se coló en un commit anterior o lo que
# se saltó el hook con --no-verify.
set -uo pipefail
raiz=$(git rev-parse --show-toplevel)
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

fallo=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Rama que se borra: nada que revisar.
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    rango="$local_sha"          # rama nueva: git limita solo con --not --remotes
    lista=$(git rev-list "$rango" --not --remotes 2>/dev/null || echo "$local_sha")
  else
    lista=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null || true)
  fi

  [ -z "$lista" ] && continue

  # Mensajes, SIN la regla de importes: esa se evalúa en commit-msg, una vez, al
  # escribir el mensaje. Acá se recorre historia ya escrita —y tras una
  # reescritura, toda— donde las cifras que quedan son de demo y documentación.
  # Repetir ahí la regla sólo produce ruido, y un guard ruidoso se ignora.
  : > "$tmp"
  for sha in $lista; do git log -1 --format=%B "$sha" >> "$tmp"; done
  "$raiz/.githooks/scan-private-data.sh" "un mensaje de commit que estás pusheando" "$tmp" || fallo=1

  # Contenido agregado.
  : > "$tmp"
  for sha in $lista; do
    git show --unified=0 --format= "$sha" | grep '^+' | grep -v '^+++' >> "$tmp" || true
  done
  "$raiz/.githooks/scan-private-data.sh" "el código que estás pusheando" "$tmp" || fallo=1
done

exit $fallo
